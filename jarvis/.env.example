# Copy this file to .env and fill in what you have. Everything here is free.

# --- You ---------------------------------------------------------------
JARVIS_USER_NAME=sir
JARVIS_CITY=Bengaluru
JARVIS_TIMEZONE=Asia/Kolkata

# --- Brain (tried in this order; at least one is needed) ----------------
# 1) Google Gemini, free tier: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# 2) Groq, free tier, very fast backup: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# 3) Ollama: fully offline on your PC (https://ollama.com). Run: ollama pull qwen3:8b
OLLAMA_ENABLED=1
OLLAMA_MODEL=qwen3:8b

# --- Voice ---------------------------------------------------------------
# Wake word sensitivity: lower = triggers more easily (0.3-0.7)
JARVIS_WAKE_THRESHOLD=0.5
# Speech recognition: large-v3-turbo (best for Kannada) or small (faster on slow PCs)
WHISPER_MODEL=large-v3-turbo
# Voices: en-IN-PrabhatNeural (male) / en-IN-NeerjaNeural (female)
VOICE_EN=en-IN-PrabhatNeural
# kn-IN-GaganNeural (male) / kn-IN-SapnaNeural (female)
VOICE_KN=kn-IN-GaganNeural

# --- Safety --------------------------------------------------------------
# 1 = Jarvis asks before sending email, running commands, deleting, power actions
JARVIS_CONFIRM_ACTIONS=1

# --- Smart home (optional, see docs/SMART_HOME_SETUP.md) -----------------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Gmail & Calendar (optional, see docs/GOOGLE_SETUP.md) ---------------
# Default location: %USERPROFILE%\.jarvis\google_credentials.json
# GOOGLE_CREDENTIALS_FILE=
